---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';

const values = [
  { title: 'Local first', text: 'We live, work, and play in West Palm Beach. We know which streets flood, which blocks are changing, and where the best coffee is.' },
  { title: 'Straight talk', text: 'Honest pricing advice and clear answers — even when it isn’t what you hoped to hear.' },
  { title: 'Always reachable', text: 'Calls and texts returned the same day. Real estate moves fast here, and so do we.' },
];
---

<Base
  title={`About ${site.agent.name}`}
  description={`${site.agent.name} is a West Palm Beach REALTOR® with ${site.brokerage.name}, with experience in residential, commercial, and new construction real estate.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>Your neighbor in West Palm Beach real estate</h1>
      <p class="lede">Guiding buyers and sellers through one of Florida’s most dynamic markets.</p>
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <div class="portrait">
        {
          site.agent.photo ? (
            <img src={site.agent.photo} alt={site.agent.name} width="560" height="680" />
          ) : (
            <div class="portrait__placeholder" aria-hidden="true">
              <span>Agent photo</span>
            </div>
          )
        }
      </div>
      <div>
        <h2>{site.agent.name}</h2>
        <p class="meta">
          {site.agent.title} · {site.brokerage.name} · <a href={site.agent.licenseUrl} rel="noopener" target="_blank">{site.agent.license}</a>
        </p>
        <img class="broker-logo" src={site.brokerage.logo} alt={site.brokerage.name} width="200" height="48" />
        <p class="bio-lede">
          I’ve worked in real estate from almost every angle — and that’s exactly what I bring to the table for my
          clients.
        </p>
        <p>
          My experience spans residential and commercial property: buying, selling, and managing new construction
          projects from the ground up. I know what goes into a property long before it hits the market, and I know
          what it takes to get a deal to the closing table.
        </p>
        <p>
          Here in West Palm Beach, I’ve served as CMO and COO of New Path Title and as CEO of James Brown Law. Leading a
          title company and a law firm gave me an inside view of contracts, closings, and the details that can make or
          break a transaction. My clients benefit from that perspective at every step.
        </p>
        <p>
          After my time with Compass, I’m now proud to represent buyers and sellers with LoKation Real Estate. What
          clients value most is how I negotiate: I prepare thoroughly, know the numbers cold, and fight for the best
          possible price and terms — whether you’re buying your first condo or selling a waterfront estate.
        </p>
        <a class="btn btn--dark" href="/contact">Get in touch</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container grid grid--3">
      {
        values.map((v) => (
          <div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .portrait img,
  .portrait__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.5);
  }
  .portrait__placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--sand-deep), #d9c7ad);
    color: var(--ink-soft);
    font-weight: 600;
  }
  .meta {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .meta a {
    color: inherit;
  }
  .bio-lede {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.4;
  }
  .broker-logo {
    height: 40px;
    width: auto;
    margin-bottom: 1.5rem;
  }
  .grid--3 p {
    color: var(--ink-soft);
  }
</style>
