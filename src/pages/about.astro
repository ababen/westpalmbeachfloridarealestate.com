---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../config/site';

const values = [
  { title: 'Local first', text: 'We live, work, and play in West Palm Beach. We know which streets flood, which blocks are changing, and where the best coffee is.' },
  { title: 'Straight talk', text: 'Honest pricing advice and clear answers — even when it isn’t what you hoped to hear.' },
  { title: 'Always reachable', text: 'Calls and texts returned the same day. Real estate moves fast here, and so do we.' },
];
---

<Base
  title="About"
  description={`${site.name} is an independent local guide to West Palm Beach condos, neighborhoods and the housing market.`}
>
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>An independent local guide to West Palm Beach real estate</h1>
      <p class="lede">Condo buildings, neighborhoods and market news, researched from public records.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p class="bio-lede">
        We publish clear, sourced information about the buildings and neighborhoods of West Palm Beach, from the
        Intracoastal towers downtown to the bungalows of Flamingo Park and Northwood.
      </p>
      <p>
        Building facts come from Palm Beach County parcel records, association documents and state filings. When
        sources disagree, we leave the field blank rather than guess, and every page says where its numbers came from.
      </p>
      <p>
        Illustrations and renderings are labeled as such, and photo credits are listed on the
        <a href="/photo-credits">photo credits</a> page.
      </p>
      <a class="btn btn--dark" href="/contact">Get in touch</a>
    </div>
  </section>

  <section class="section section--white">
    <div class="container grid grid--3">
      {
        values.map((v) => (
          <div>
            <h3>{v.title}</h3>
            <p>{v.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .prose {
    max-width: 46rem;
  }
  .bio-lede {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.4;
  }
  .grid--3 p {
    color: var(--ink-soft);
  }
</style>
