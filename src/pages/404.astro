---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found">
  <section class="page-hero">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>This page has moved on.</h1>
      <p class="lede">Like a hot listing, it’s gone. Try one of these instead:</p>
      <p class="links">
        <a class="btn btn--primary" href="/listings">Search homes</a>
        <a class="btn btn--ghost" href="/neighborhoods">Neighborhoods</a>
        <a class="btn btn--ghost" href="/">Home</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
