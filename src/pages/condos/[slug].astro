---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import BuildingCard from '../../components/BuildingCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import BuildingArt from '../../components/BuildingArt.astro';
import { buildings, areaNeighborhood, areaSlug, photoCredit, type Building } from '../../data/buildings';
import { neighborhoods } from '../../data/neighborhoods';
import { landmarks, milesBetween } from '../../data/landmarks';
import { site } from '../../config/site';

export function getStaticPaths() {
  return buildings.map((b) => ({ params: { slug: b.slug }, props: { b } }));
}

const { b } = Astro.props as { b: Building };
const hood = neighborhoods.find((n) => n.slug === areaNeighborhood[b.area]);
const street = b.address.split(',')[0];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${b.name}, ${b.address}`)}`;
const d = 0.006;
const streetViewEmbed =
  b.streetView && site.googleMapsKey
    ? `https://www.google.com/maps/embed/v1/streetview?${new URLSearchParams({
        key: site.googleMapsKey,
        pano: b.streetView.pano,
        heading: String(b.streetView.heading),
        pitch: '10',
        fov: '80',
      })}`
    : null;
const mapEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${b.lng - d},${b.lat - d},${b.lng + d},${b.lat + d}&layer=mapnik&marker=${b.lat},${b.lng}`;

// Closest buildings first, regardless of area label.
const nearby = buildings
  .filter((o) => o.slug !== b.slug)
  .map((o) => ({ o, miles: milesBetween(b, o) }))
  .sort((x, y) => x.miles - y.miles)
  .slice(0, 3)
  .map((x) => x.o);

const fmtMiles = (m: number) => (m < 0.1 ? 'Under 0.1 mi' : `${m.toFixed(1)} mi`);
const distances = landmarks.map((l) => ({ name: l.name, miles: milesBetween(b, l) })).sort((x, y) => x.miles - y.miles);

const isDone = b.status === 'completed';
const statusLabel = b.status[0].toUpperCase() + b.status.slice(1);

const facts: [string, string][] = [
  ['Address', b.address],
  ['Area', b.area],
  ['Status', statusLabel],
  b.yearBuilt ? [isDone ? 'Year built' : 'Expected completion', String(b.yearBuilt)] : null,
  b.floors ? ['Floors', String(b.floors)] : null,
  b.units ? ['Residences', String(b.units)] : null,
  b.bedrooms ? ['Bedrooms', b.bedrooms] : null,
  b.sqftRange ? ['Residence sizes', `${b.sqftRange} sq ft`] : null,
  b.developer ? ['Developer', b.developer] : null,
  b.architect ? ['Architect', b.architect] : null,
  b.waterfront ? ['Waterfront', 'Yes, facing the Intracoastal'] : null,
  b.parking ? ['Parking', b.parking] : null,
  b.petPolicy ? ['Pets', b.petPolicy] : null,
  b.rentalPolicy ? ['Rentals', b.rentalPolicy] : null,
].filter((f): f is [string, string] => f !== null);

// FAQ built only from facts on this page.
const faqs: { q: string; a: string }[] = [];
if (b.yearBuilt)
  faqs.push(
    isDone
      ? { q: `When was ${b.name} built?`, a: `${b.name} was completed in ${b.yearBuilt}.` }
      : { q: `When will ${b.name} be completed?`, a: `${b.name} is ${b.status}, with completion expected in ${b.yearBuilt}.` },
  );
if (!isDone && !b.yearBuilt)
  faqs.push({
    q: `What is the status of ${b.name}?`,
    a: `${b.name} is ${b.status}. No completion date has been published yet.`,
  });
if (b.floors || b.units)
  faqs.push({
    q: `How big is ${b.name}?`,
    a: `${b.name} ${isDone ? 'has' : 'is planned with'} ${[b.floors && `${b.floors} floors`, b.units && `${b.units} residences`].filter(Boolean).join(' and ')}.`,
  });
if (b.bedrooms || b.sqftRange)
  faqs.push({
    q: `What size are the residences at ${b.name}?`,
    a:
      b.bedrooms && b.sqftRange
        ? `Residences have ${b.bedrooms} bedrooms and range from about ${b.sqftRange} square feet.`
        : b.bedrooms
          ? `Residences have ${b.bedrooms} bedrooms.`
          : `Residences are about ${b.sqftRange} square feet.`,
  });
if (b.waterfront) faqs.push({ q: `Is ${b.name} on the water?`, a: `Yes. ${b.name} faces the Intracoastal Waterway along Flagler Drive.` });
if (b.petPolicy) faqs.push({ q: `Does ${b.name} allow pets?`, a: `${b.petPolicy}. Confirm current rules with the association before you buy.` });
if (b.amenities.length)
  faqs.push({ q: `What amenities does ${b.name} have?`, a: `Amenities include ${b.amenities.slice(0, 6).join(', ')}.` });
faqs.push({
  q: `How do I find units for sale at ${b.name}?`,
  a: `Use the form on this page or call ${site.phone} for current listings, recent sale prices, and upcoming availability at ${b.name}.`,
});

const description = `${b.name}${b.floors ? `, a ${b.floors}-story` : ', a'} ${isDone ? '' : `${b.status} `}condominium at ${street}, West Palm Beach. Building facts, amenities, location, and units for sale.`;
---

<Base
  title={`${b.name} Condos for Sale | ${street}`}
  description={description}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'ApartmentComplex',
      name: b.name,
      ...(b.aka?.length && { alternateName: b.aka }),
      description: b.description || b.summary,
      address: {
        '@type': 'PostalAddress',
        streetAddress: street,
        addressLocality: 'West Palm Beach',
        addressRegion: 'FL',
        postalCode: b.address.match(/\d{5}/)?.[0],
        addressCountry: 'US',
      },
      geo: { '@type': 'GeoCoordinates', latitude: b.lat, longitude: b.lng },
      ...(b.units && { numberOfAccommodationUnits: b.units }),
      ...(b.petPolicy && { petsAllowed: !/no pets|not allowed/i.test(b.petPolicy) }),
      ...(b.amenities.length && {
        ...(b.photo && { image: new URL(b.photo.src, site.url).href }),
        amenityFeature: b.amenities.map((a) => ({ '@type': 'LocationFeatureSpecification', name: a, value: true })),
      }),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Condos', item: `${Astro.site}condos` },
        { '@type': 'ListItem', position: 2, name: b.area, item: `${Astro.site}condos#${areaSlug(b.area)}` },
        { '@type': 'ListItem', position: 3, name: b.name },
      ],
    },
  ]}
>
  <section class="page-hero">
    <div class="container hero-grid">
      <div>
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/condos">Condos</a> / <a href={`/condos#${areaSlug(b.area)}`}>{b.area}</a> / {b.name}
      </nav>
      {!isDone && <span class="badge">{statusLabel}</span>}
      <h1>{b.name}</h1>
      <p class="lede">{b.address}</p>
      {b.altAddresses?.length ? <p class="aka">Also listed at {b.altAddresses.join('; ')}</p> : null}
      {b.aka?.length ? <p class="aka">Also known as {b.aka.join(', ')}</p> : null}
      <ul class="quick">
        {b.floors && <li><strong>{b.floors}</strong> floors</li>}
        {b.units && <li><strong>{b.units}</strong> residences</li>}
        {b.yearBuilt && <li><strong>{b.yearBuilt}</strong> {isDone ? 'built' : 'est. completion'}</li>}
        {b.waterfront && <li><strong>Waterfront</strong></li>}
      </ul>
      </div>
      {!b.photo && (
        <figure class="hero-photo">
          <BuildingArt b={b} class="hero-art" />
          <figcaption>Illustration</figcaption>
        </figure>
      )}
      {
        b.photo && (
          <figure class="hero-photo">
            <img src={b.photo.src} width={b.photo.width} height={b.photo.height} alt={b.photo.alt} fetchpriority="high" decoding="async" />
            <figcaption>
              <a href={b.photo.sourceUrl} rel="noopener" target="_blank">{photoCredit(b.photo)}</a>
              {b.photo.licenseUrl && (
                <>
                  {' · '}
                  <a href={b.photo.licenseUrl} rel="noopener license" target="_blank">license</a>
                </>
              )}
            </figcaption>
          </figure>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <article>
        <p class="intro">{b.description || b.summary}</p>

        <h2 class="sub">Building facts</h2>
        <dl class="facts">
          {
            facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))
          }
        </dl>

        {
          b.amenities.length > 0 && (
            <>
              <h2 class="sub">Amenities</h2>
              <ul class="check-list amenities">
                {b.amenities.map((a) => (
                  <li>{a[0].toUpperCase() + a.slice(1)}</li>
                ))}
              </ul>
            </>
          )
        }

        <h2 class="sub">Location</h2>
        <div class="map">
          <iframe src={mapEmbed} title={`Map of ${b.name}`} loading="lazy"></iframe>
        </div>
        <p class="map-links">
          <a href={mapUrl} rel="noopener" target="_blank">Open in Google Maps →</a>
        </p>
        {
          streetViewEmbed && (
            <>
              <h3 class="dist-head">Street view</h3>
              <div class="map">
                <iframe src={streetViewEmbed} title={`Street view of ${b.name}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
              </div>
            </>
          )
        }
        <h3 class="dist-head">Distance to</h3>
        <ul class="dist">
          {
            distances.map((x) => (
              <li>
                <span>{x.name}</span>
                <span>{fmtMiles(x.miles)}</span>
              </li>
            ))
          }
        </ul>
        <p class="fine">Straight-line distances; travel distances will be longer.</p>

        {
          hood && (
            <p class="hood">
              <strong>Neighborhood:</strong> {b.name} is in <a href={`/neighborhoods/${hood.slug}`}>{hood.name}</a>.{' '}
              {hood.summary}
            </p>
          )
        }

        <h2 class="sub">Frequently asked questions</h2>
        {
          faqs.map((f) => (
            <details class="faq">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }

        <p class="note">
          Building details are compiled from public sources and may change. Verify all information independently.
        </p>
      </article>

      <aside class="card sticky">
        <h3>Units at {b.name}</h3>
        <p>Get current listings, recent sale prices, and building insights for {b.name}.</p>
        <LeadForm kind="building" building={b.name} submitLabel="Send Me Details" />
      </aside>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <h2>Nearby condo buildings</h2>
      <div class="grid grid--3">
        {nearby.map((o) => <BuildingCard b={o} />)}
      </div>
      <p class="all"><a class="btn btn--dark" href="/condos">See all West Palm Beach condos</a></p>
    </div>
  </section>

  <CtaBand heading={`Buying or selling at ${b.name}?`} />
</Base>

<style>
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
    color: rgb(247 241 232 / 0.75);
  }
  .crumbs a {
    color: inherit;
  }
  .badge {
    display: inline-block;
    background: var(--coral);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 0.75rem;
  }
  .aka {
    color: rgb(247 241 232 / 0.7);
    margin: 0;
  }
  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  .quick li {
    border: 1px solid rgb(247 241 232 / 0.35);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.92rem;
  }
  .intro {
    font-size: 1.12rem;
    line-height: 1.7;
  }
  .sub {
    font-size: 1.6rem;
    margin-top: 2.25rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    margin: 0;
  }
  .facts div {
    padding: 0.8rem 1rem;
    box-shadow:
      1px 0 0 var(--line),
      0 1px 0 var(--line);
  }
  .facts dt {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-weight: 500;
  }
  .amenities {
    columns: 2 220px;
  }
  .amenities li {
    break-inside: avoid;
  }
  .map {
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--line);
    aspect-ratio: 16 / 10;
    background: var(--sand-deep);
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-links {
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }
  .dist-head {
    font-size: 1.1rem;
    margin-top: 1.5rem;
  }
  .dist {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--line);
  }
  .dist li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--line);
  }
  .dist li span:last-child {
    font-weight: 600;
    white-space: nowrap;
  }
  .fine {
    font-size: 0.82rem;
    color: var(--ink-soft);
    margin-top: 0.5rem;
  }
  .hood {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--sand-deep);
    border-radius: 10px;
  }
  .faq {
    border-bottom: 1px solid var(--line);
    padding-block: 0.9rem;
  }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
  }
  .faq p {
    margin: 0.6rem 0 0;
    color: var(--ink-soft);
  }
  .note {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: 2rem;
  }
  .sticky {
    position: sticky;
    top: 100px;
  }
  .section--white h2 {
    margin-bottom: 1.5rem;
  }
  .all {
    margin-top: 2rem;
    text-align: center;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
    gap: 2rem;
    align-items: center;
  }
  @media (max-width: 860px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  .hero-photo {
    margin: 0;
  }
  .hero-photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    display: block;
  }
  .hero-photo :global(.hero-art) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    display: block;
  }
  .hero-photo figcaption {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    opacity: 0.85;
  }
  .hero-photo figcaption a {
    color: inherit;
  }
</style>
