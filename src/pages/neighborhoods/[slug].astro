---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import NeighborhoodCard from '../../components/NeighborhoodCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { neighborhoods, type Neighborhood, neighborhoodImage, illustrationCredit } from '../../data/neighborhoods';
import BuildingCard from '../../components/BuildingCard.astro';
import { buildings, areaNeighborhood } from '../../data/buildings';

export function getStaticPaths() {
  return neighborhoods.map((n) => ({ params: { slug: n.slug }, props: { n } }));
}

const { n } = Astro.props as { n: Neighborhood };
const others = neighborhoods.filter((o) => o.slug !== n.slug).slice(0, 3);
const condos = buildings.filter((b) => areaNeighborhood[b.area] === n.slug);
const [from, to] = n.palette;
const img = neighborhoodImage(n.slug);
---

<Base
  title={`${n.name} Homes for Sale & Neighborhood Guide`}
  description={n.summary}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Neighborhoods', item: `${Astro.site}neighborhoods` },
        { '@type': 'ListItem', position: 2, name: n.name },
      ],
    },
  ]}
>
  <section class="page-hero hood-hero" style={`--from:${from};--to:${to}`}>
    {img && <img class="hood-hero__img" src={img.src} width={img.width} height={img.height} alt="" fetchpriority="high" decoding="async" />}
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/neighborhoods">Neighborhoods</a> / {n.name}</nav>
      <h1>{n.name}</h1>
      <p class="lede">{n.tagline}</p>
    </div>
    {img && <span class="hood-hero__credit">{illustrationCredit(img)}</span>}
  </section>

  <section class="section">
    <div class="container grid grid--2">
      <article>
        <p class="lede">{n.summary}</p>
        {n.body.map((p) => <p>{p}</p>)}

        <h2 class="sub">Home styles</h2>
        <ul class="tags">{n.homeStyles.map((s) => <li>{s}</li>)}</ul>

        <h2 class="sub">Highlights</h2>
        <ul class="check-list">{n.highlights.map((h) => <li>{h}</li>)}</ul>

        <p class="best"><strong>Best for:</strong> {n.bestFor}</p>
      </article>

      <aside class="card sticky">
        <h3>Homes in {n.name}</h3>
        <p>Get new listings and recent sale prices for {n.name} sent straight to your inbox.</p>
        <LeadForm kind="buy" submitLabel="Send Me Listings" area={n.name} />
      </aside>
    </div>
  </section>

  {
    condos.length > 0 && (
      <section class="section section--white">
        <div class="container">
          <h2>Condo buildings in {n.name}</h2>
          <div class="grid grid--3">
            {condos.map((b) => (
              <BuildingCard b={b} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class:list={['section', { 'section--white': condos.length === 0 }]}>
    <div class="container">
      <h2>Explore nearby neighborhoods</h2>
      <div class="grid grid--3">{others.map((o) => <NeighborhoodCard n={o} />)}</div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hood-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--ink) 10%, var(--from) 70%, var(--to) 130%);
  }
  .hood-hero__img {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Dark wash on the text side keeps the heading and tagline readable over the illustration. */
  .hood-hero:has(.hood-hero__img)::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(90deg, rgb(11 31 45 / 0.88) 0%, rgb(11 31 45 / 0.6) 55%, rgb(11 31 45 / 0.25) 100%);
  }
  @media (max-width: 720px) {
    .hood-hero:has(.hood-hero__img)::before {
      background: rgb(11 31 45 / 0.68);
    }
  }
  .hood-hero > .container {
    position: relative;
    z-index: 2;
  }
  .hood-hero__credit {
    position: absolute;
    z-index: 2;
    right: 0.75rem;
    bottom: 0.5rem;
    font-size: 0.7rem;
    color: rgb(255 255 255 / 0.8);
  }
  .crumbs {
    font-size: 0.9rem;
    margin-bottom: 1rem;
    color: rgb(247 241 232 / 0.75);
  }
  .crumbs a {
    color: inherit;
  }
  .sub {
    font-size: 1.6rem;
    margin-top: 2rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tags li {
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.9rem;
    font-size: 0.92rem;
  }
  .best {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    background: var(--sand-deep);
    border-radius: 10px;
  }
  .sticky {
    position: sticky;
    top: 100px;
  }
  .section h2 {
    margin-bottom: 1.5rem;
  }
</style>
