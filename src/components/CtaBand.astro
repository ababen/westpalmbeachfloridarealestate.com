---
import { site, telHref } from '../config/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready to make your move in West Palm Beach?',
  text = 'Whether you’re buying your first condo or selling a waterfront estate, start with a no-pressure conversation.',
} = Astro.props;
---

<section class="cta">
  <div class="container cta__inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href="/contact">Schedule a Consultation</a>
      <a class="btn btn--ghost" href={telHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(120deg, var(--sea-deep), var(--sea));
    color: var(--white);
    padding-block: clamp(48px, 7vw, 80px);
  }
  .cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .cta h2 {
    margin-bottom: 0.4rem;
  }
  .cta p {
    margin: 0;
    max-width: 38rem;
    color: rgb(255 255 255 / 0.85);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
