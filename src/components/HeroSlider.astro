---
import type { Building } from '../data/buildings';

interface Props {
  items: Building[];
}

const { items } = Astro.props;

// Sky colours per area, so slides differ at a glance.
const SKIES: Record<string, [string, string]> = {
  Downtown: ['#16384f', '#e39a78'],
  'South Flagler': ['#123247', '#7fc3c9'],
  'North Flagler': ['#1b3d5a', '#f0b48d'],
  Northwood: ['#183a4e', '#c9a2c8'],
  'Lands of the President': ['#173a4a', '#9fd0b4'],
};

const facts = (b: Building) =>
  [
    b.floors && `${b.floors} floors`,
    b.units && `${b.units} residences`,
    b.yearBuilt && (b.status === 'completed' ? `Built ${b.yearBuilt}` : `Est. ${b.yearBuilt}`),
  ]
    .filter(Boolean)
    .join(' · ');

// Tower height follows the floor count; small neighbours fill out the skyline.
const art = (b: Building) => {
  const h = Math.min(300, 90 + (b.floors ?? 12) * 7);
  const [top, bottom] = SKIES[b.area] ?? SKIES.Downtown;
  return { h, top, bottom };
};
---

<div class="slider" role="region" aria-roledescription="carousel" aria-label="Featured condo buildings" data-slider>
  <div class="slides">
    {
      items.map((b, i) => {
        const a = art(b);
        return (
          <div
            class="slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${items.length}`}
            aria-hidden={i === 0 ? undefined : 'true'}
            data-active={i === 0 ? '' : undefined}
          >
            <a class="slide__link" href={`/condos/${b.slug}`} tabindex={i === 0 ? undefined : -1}>
            <svg viewBox="0 0 400 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
              <defs>
                <linearGradient id={`sky-${b.slug}`} x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color={a.top} />
                  <stop offset="1" stop-color={a.bottom} />
                </linearGradient>
              </defs>
              <rect width="400" height="400" fill={`url(#sky-${b.slug})`} />
              <circle cx="310" cy="90" r="34" fill="rgb(255 255 255 / 0.35)" />
              <rect x="70" y={340 - a.h * 0.42} width="48" height={a.h * 0.42} rx="3" fill="rgb(15 42 61 / 0.35)" />
              <rect x="150" y={340 - a.h} width="96" height={a.h} rx="4" fill="rgb(15 42 61 / 0.7)" />
              <rect x="254" y={340 - a.h * 0.58} width="58" height={a.h * 0.58} rx="3" fill="rgb(15 42 61 / 0.45)" />
              <g fill="rgb(255 240 220 / 0.45)">
                {Array.from({ length: Math.floor((a.h - 30) / 26) }, (_, r) => (
                  <>
                    <rect x="166" y={340 - a.h + 18 + r * 26} width="14" height="8" />
                    <rect x="191" y={340 - a.h + 18 + r * 26} width="14" height="8" />
                    <rect x="216" y={340 - a.h + 18 + r * 26} width="14" height="8" />
                  </>
                ))}
              </g>
              {b.waterfront ? (
                <path d="M0 330c70-12 130-12 200 0s130 12 200 0v70H0z" fill="#0f6f8f" />
              ) : (
                <rect y="338" width="400" height="62" fill="#1d3b4c" />
              )}
            </svg>
            <span class="caption">
              <span class="caption__area">{b.area}{b.status !== 'completed' && ` · ${b.status}`}</span>
              <span class="caption__name">{b.name}</span>
              {facts(b) && <span class="caption__facts">{facts(b)}</span>}
              <span class="caption__cta">View building →</span>
            </span>
            </a>
          </div>
        );
      })
    }
  </div>
  <div class="controls">
    <button type="button" class="nav" data-prev aria-label="Previous building">‹</button>
    <div class="dots">
      {items.map((b, i) => <button type="button" class="dot" data-dot={i} aria-label={`Show ${b.name}`} aria-current={i === 0 ? 'true' : undefined} />)}
    </div>
    <button type="button" class="nav" data-next aria-label="Next building">›</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    let current = 0;
    let timer: number | undefined;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, n) => {
        const on = n === current;
        s.toggleAttribute('data-active', on);
        if (on) s.removeAttribute('aria-hidden');
        else s.setAttribute('aria-hidden', 'true');
        s.querySelector('a')!.tabIndex = on ? 0 : -1;
      });
      dots.forEach((d, n) => (n === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };

    // Auto-advance only when motion is welcome, and never while someone is reading or interacting.
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const stop = () => clearInterval(timer);
    const start = () => {
      stop();
      if (!calm) timer = window.setInterval(() => show(current + 1), 6000);
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => (show(current - 1), start()));
    root.querySelector('[data-next]')!.addEventListener('click', () => (show(current + 1), start()));
    dots.forEach((d, n) => d.addEventListener('click', () => (show(n), start())));
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    // Swipe on touch screens.
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => (x0 = e.touches[0].clientX), { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1)), start();
      x0 = null;
    });

    start();
  });
</script>

<style>
  .slider {
    position: relative;
    width: 100%;
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.5);
    background: var(--ink);
  }
  .slides {
    position: relative;
    aspect-ratio: 1 / 1;
  }
  .slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.6s ease,
      visibility 0.6s;
  }
  .slide[data-active] {
    opacity: 1;
    visibility: visible;
  }
  .slide__link {
    display: block;
    height: 100%;
    color: var(--white);
    text-decoration: none;
  }
  .slide svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Solid panel (not a fade over artwork) keeps the text at full contrast. */
  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.2rem;
    padding: 1rem 1.25rem 3.4rem;
    background: rgb(11 31 45 / 0.92);
  }
  .caption__area {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2b38f;
  }
  .caption__name {
    font: 600 1.35rem/1.2 var(--font-display);
  }
  .caption__facts {
    font-size: 0.95rem;
    color: rgb(255 255 255 / 0.9);
  }
  .caption__cta {
    margin-top: 0.3rem;
    font-weight: 600;
    font-size: 0.95rem;
    color: #7fd1d6;
  }
  .slide__link:hover .caption__cta,
  .slide__link:focus-visible .caption__cta {
    text-decoration: underline;
  }
  .slide__link:focus-visible {
    outline: 3px solid #7fd1d6;
    outline-offset: -3px;
  }
  .controls {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 0.75rem;
  }
  .nav {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.4);
    background: transparent;
    color: var(--white);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }
  .nav:hover,
  .nav:focus-visible {
    background: rgb(255 255 255 / 0.15);
  }
  .dots {
    display: flex;
    gap: 0.4rem;
  }
  .dot {
    width: 9px;
    height: 9px;
    padding: 0;
    border-radius: 50%;
    border: 0;
    background: rgb(255 255 255 / 0.4);
    cursor: pointer;
  }
  .dot[aria-current='true'] {
    background: var(--white);
    width: 22px;
    border-radius: 5px;
  }
  @media (max-width: 960px) {
    .slides {
      aspect-ratio: 1 / 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
