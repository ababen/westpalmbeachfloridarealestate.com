---
import { photoCredit, type Building } from '../data/buildings';
import BuildingArt from './BuildingArt.astro';

interface Props {
  b: Building;
}

const { b } = Astro.props;
const facts = [
  b.floors && `${b.floors} floors`,
  b.units && `${b.units} residences`,
  b.yearBuilt && (b.status === 'completed' ? `Built ${b.yearBuilt}` : `Est. ${b.yearBuilt}`),
].filter(Boolean);
---

<a class="bcard" href={`/condos/${b.slug}`}>
  <div class="bcard__art" aria-hidden="true">
    {
      b.photo && (
        <>
          <img src={b.photo.src} width={b.photo.width} height={b.photo.height} alt="" loading="lazy" decoding="async" />
          <span class="bcard__credit">{photoCredit(b.photo)}</span>
        </>
      )
    }
    <BuildingArt b={b} class="bcard__svg" />
    {b.status !== 'completed' && <span class="bcard__badge">{b.status}</span>}
  </div>
  <div class="bcard__body">
    <h3>{b.name}</h3>
    <p class="bcard__addr">{b.address.replace(/,?\s*West Palm Beach.*$/i, '')}</p>
    {facts.length > 0 && <p class="bcard__facts">{facts.join(' · ')}</p>}
  </div>
</a>

<style>
  .bcard {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .bcard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .bcard__art {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #1a0b3d;
  }
  .bcard__art :global(.bcard__svg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .bcard__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
  }
  .bcard__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    max-width: 100%;
    padding: 0.15rem 0.45rem;
    font-size: 0.65rem;
    color: var(--white);
    background: rgb(11 31 45 / 0.7);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .bcard__badge {
    z-index: 2;
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--coral);
    color: var(--white);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
  }
  .bcard__body {
    padding: 1.2rem 1.4rem 1.4rem;
  }
  .bcard__body h3 {
    margin-bottom: 0.25rem;
  }
  .bcard__addr {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0;
  }
  .bcard__facts {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--sea);
    margin: 0.6rem 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .bcard {
      transition: none;
    }
  }
</style>
