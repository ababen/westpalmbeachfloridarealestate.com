---
// Miami Vice–style illustration of a building: synthwave sky, striped sun, palms, neon outline.
// Shape and finish come from src/data/buildingLooks.ts; height follows the floor count.
import type { Building } from '../data/buildings';
import { lookFor } from '../data/buildingLooks';

interface Props {
  b: Building;
  class?: string;
}

const { b, class: className } = Astro.props;
const look = lookFor(b);
const id = `art-${b.slug}-${Math.random().toString(36).slice(2, 7)}`;

const GROUND = 252;
// Unknown floor counts: towers default to a mid-height, low-rise styles stay low.
const floors = b.floors ?? (look.shape === 'arches' ? 8 : 20);
const tall = Math.min(205, 55 + floors * 6);
const cx = 175;

const FINISH = {
  glass: { fill: `url(#${id}-glass)`, line: 'rgb(180 255 250 / 0.35)', neon: '#2ee6d6' },
  white: { fill: '#f7e6f1', line: 'rgb(150 70 130 / 0.35)', neon: '#ff3cac' },
  stucco: { fill: '#f9c9a3', line: 'rgb(150 70 60 / 0.35)', neon: '#ff3cac' },
}[look.finish];

type Box = { x: number; w: number; h: number };
const boxes: Box[] =
  look.shape === 'twin'
    ? [
        { x: cx - 68, w: 58, h: tall },
        { x: cx + 6, w: 58, h: Math.round(tall * 0.86) },
      ]
    : look.shape === 'arches'
      ? [{ x: cx - 95, w: 190, h: Math.min(tall, 120) }]
      : [{ x: cx - 48, w: 96, h: tall }];

// Outline path for each block; "curved" bulges the right-hand face.
const outline = ({ x, w, h }: Box) =>
  look.shape === 'curved'
    ? `M${x} ${GROUND}V${GROUND - h}H${x + w * 0.55}C${x + w * 1.2} ${GROUND - h} ${x + w * 1.2} ${GROUND} ${x + w * 0.7} ${GROUND}Z`
    : `M${x} ${GROUND}V${GROUND - h}H${x + w}V${GROUND}Z`;

// Floor bands (balconies or glazing lines) every ~9px.
const bands = ({ x, w, h }: Box) =>
  Array.from({ length: Math.floor((h - 10) / 9) }, (_, i) => GROUND - h + 10 + i * 9).map((y) => ({ x, y, w: look.shape === 'curved' ? w * 0.9 : w }));

const arches = look.shape === 'arches' ? Array.from({ length: 6 }, (_, i) => boxes[0].x + 12 + i * 30) : [];
const palm = (x: number, s: number) =>
  `M${x} ${GROUND}c${4 * s} -${40 * s} ${2 * s} -${80 * s} -${6 * s} -${110 * s}l${4 * s} -1c${10 * s} ${30 * s} ${12 * s} ${70 * s} ${8 * s} ${111 * s}z`;
const fronds = (x: number, y: number, s: number) =>
  [
    [-38, 10],
    [-30, -14],
    [0, -26],
    [30, -14],
    [38, 12],
  ].map(([dx, dy]) => `M${x} ${y}q${(dx / 2) * s} ${(dy - 12) * s} ${dx * s} ${dy * s}q${(-dx / 3) * s} ${-4 * s} ${-dx * s} ${-dy * s}z`);
---

<svg class={className} viewBox="0 0 400 300" preserveAspectRatio="xMidYMax slice" role="img" aria-label={`Illustration of ${b.name}`}>
  <defs>
    <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1a0b3d"></stop>
      <stop offset="0.45" stop-color="#5b1a6e"></stop>
      <stop offset="0.75" stop-color="#d6246e"></stop>
      <stop offset="1" stop-color="#ff8a3d"></stop>
    </linearGradient>
    <linearGradient id={`${id}-sun`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffd36e"></stop>
      <stop offset="1" stop-color="#ff3c8e"></stop>
    </linearGradient>
    <linearGradient id={`${id}-glass`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#3fd6e0"></stop>
      <stop offset="1" stop-color="#22508f"></stop>
    </linearGradient>
    <linearGradient id={`${id}-water`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1f8fa6"></stop>
      <stop offset="1" stop-color="#14204a"></stop>
    </linearGradient>
    <filter id={`${id}-glow`} x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="2.2" result="b"></feGaussianBlur>
      <feMerge><feMergeNode in="b"></feMergeNode><feMergeNode in="SourceGraphic"></feMergeNode></feMerge>
    </filter>
    <mask id={`${id}-stripes`}>
      <rect width="400" height="300" fill="white"></rect>
      {[118, 132, 144, 155, 165].map((y, i) => <rect x="0" y={y} width="400" height={2 + i} fill="black" />)}
    </mask>
  </defs>

  <rect width="400" height="300" fill={`url(#${id}-sky)`}></rect>
  <g fill="#fff" opacity="0.7">
    {[[30, 30], [80, 60], [140, 22], [210, 48], [250, 18], [370, 40], [330, 70], [110, 95]].map(([x, y]) => <circle cx={x} cy={y} r="1.2" />)}
  </g>
  <circle cx="300" cy="140" r="64" fill={`url(#${id}-sun)`} mask={`url(#${id}-stripes)`}></circle>

  <g filter={`url(#${id}-glow)`}>
    {
      boxes.map((box) => (
        <>
          <path d={outline(box)} fill={FINISH.fill} />
          {bands(box).map((r) => (
            <rect x={r.x + 5} y={r.y} width={r.w - 10} height="2" fill={FINISH.line} />
          ))}
          <path d={outline(box)} fill="none" stroke={FINISH.neon} stroke-width="2" />
        </>
      ))
    }
    {
      arches.map((x) => (
        <path d={`M${x} ${GROUND}v-16a9 9 0 0 1 18 0v16z`} fill="#5b1a6e" opacity="0.75" />
      ))
    }
  </g>

  {
    b.waterfront ? (
      <>
        <rect y={GROUND} width="400" height={300 - GROUND} fill={`url(#${id}-water)`} />
        <path d={`M262 ${GROUND + 8}h76M272 ${GROUND + 18}h56M284 ${GROUND + 28}h32`} stroke="#ffb36e" stroke-width="3" opacity="0.55" />
        <path d={`M30 ${GROUND + 12}h90M200 ${GROUND + 20}h120M80 ${GROUND + 32}h140M260 ${GROUND + 40}h100`} stroke="#ff7ac0" stroke-width="2" opacity="0.6" />
      </>
    ) : (
      <>
        <rect y={GROUND} width="400" height={300 - GROUND} fill="#2a1040" />
        <path d={`M0 ${GROUND + 1}H400`} stroke="#2ee6d6" stroke-width="2" opacity="0.8" />
      </>
    )
  }

  <g fill="#1a0b2e">
    <path d={palm(42, 1)}></path>
    {fronds(40, GROUND - 110, 1).map((d) => <path d={d} />)}
    <path d={palm(362, 0.8)}></path>
    {fronds(360, GROUND - 88, 0.8).map((d) => <path d={d} />)}
  </g>
</svg>
