---
import { neighborhoodImage, illustrationCredit, type Neighborhood } from '../data/neighborhoods';

interface Props {
  n: Neighborhood;
}

const { n } = Astro.props;
const [from, to] = n.palette;
const img = neighborhoodImage(n.slug);
---

<a class="hood" href={`/neighborhoods/${n.slug}`} style={`--from:${from};--to:${to}`}>
  <div class="hood__art" aria-hidden="true">
    {
      img && (
        <>
          <img src={img.src} width={img.width} height={img.height} alt="" loading="lazy" decoding="async" />
          <span class="hood__credit">{illustrationCredit(img)}</span>
        </>
      )
    }
    <svg viewBox="0 0 400 200" preserveAspectRatio="xMidYMax slice">
      <circle cx="310" cy="70" r="34" fill="rgb(255 255 255 / 0.35)"></circle>
      <path d="M0 150c60-14 110-14 200 0s140 14 200 0v50H0z" fill="rgb(255 255 255 / 0.18)"></path>
      <path d="M0 170c60-12 110-12 200 0s140 12 200 0v30H0z" fill="rgb(255 255 255 / 0.22)"></path>
      <path d="M70 160c4-30 2-60-6-86" stroke="rgb(15 42 61 / 0.55)" stroke-width="5" fill="none" stroke-linecap="round"></path>
      <path
        d="M64 74c-16-14-38-12-48-2 16-2 30 2 48 2zm0 0c-6-20-22-30-38-30 12 8 24 16 38 30zm0 0c10-16 32-22 48-16-16 4-30 10-48 16zm0 0c16-6 32 0 42 10-16-4-28-6-42-10z"
        fill="rgb(15 42 61 / 0.55)"></path>
    </svg>
  </div>
  <div class="hood__body">
    <h3>{n.name}</h3>
    <p>{n.tagline}</p>
    <span class="hood__more">Explore neighborhood →</span>
  </div>
</a>

<style>
  .hood {
    display: flex;
    flex-direction: column;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition:
      transform 0.25s,
      box-shadow 0.25s;
  }
  .hood:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }
  .hood__art {
    position: relative;
    aspect-ratio: 2 / 1;
    background: linear-gradient(135deg, var(--from), var(--to));
  }
  .hood__art img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hood__art img ~ svg {
    display: none;
  }
  .hood__credit {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.15rem 0.45rem;
    font-size: 0.65rem;
    color: var(--white);
    background: rgb(11 31 45 / 0.7);
  }
  .hood__art svg {
    width: 100%;
    height: 100%;
  }
  .hood__body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .hood__body p {
    color: var(--ink-soft);
    font-size: 0.97rem;
    flex: 1;
  }
  .hood__more {
    font-weight: 600;
    color: var(--sea);
    font-size: 0.95rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .hood {
      transition: none;
    }
  }
</style>
